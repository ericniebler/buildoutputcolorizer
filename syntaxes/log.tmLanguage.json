{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Log",
	"scopeName": "source.log",
	"patterns": [
		{ "include": "#nvc++" },
		{ "include": "#gcc" },
		{ "include": "#clang" },
		{ "include": "#msvc" },
		{ "include": "#cmake" }
	],
	"repository": {
		"nvc++": {
			"patterns": [
				{
					"match": "catastrophic error(?=:)",
					"name": "markup.other.log.error"
				}
			]
		},
		"gcc": {
			"patterns": [
				{
					"match": "\\berror(?=:)",
					"name": "markup.other.log.error"
				},
				{
					"match": "undefined reference to `.*'",
					"name": "markup.other.log.error"
				},
				{
					"match": "multiple definition of `.*'",
					"name": "markup.other.log.error"
				},
				{
					"match": "\\bwarning(?=:)",
					"name": "markup.other.log.warn"
				},
				{
					"match": "\\bnote(?=:)",
					"name": "markup.other.log.info"
				},
				{
					"begin": "\\b_ERROR_?<",
					"end": "(?<!-)>",
					"name": "markup.other.log.error",
					"contentName": "markup.other.log.error",
					"patterns": [
						{"include": "#tparams"},
						{"include": "#mstring"}
					]
				},
				{
					"begin": "\\b_WARNING_?<",
					"end": "(?<!-)>",
					"name": "markup.other.log.warn",
					"contentName": "markup.other.log.warn",
					"patterns": [
						{"include": "#tparams"},
						{"include": "#mstring"}
					]
				},
				{
					"match": "~*\\^~*",
					"name": "markup.other.log.warn"
				},
				{
					"match": "[ \\t]+[0-9]+[ \\t]+\\|(.*)$",
					"captures": { "1": { "name": "markup.other.log.warn" } }
				}
			]
		},
		"clang": {
			"patterns": [
			]
		},
		"msvc": {
			"patterns": [
				{
					"match": "\\berror C[0-9]+(?=:)",
					"name": "markup.other.log.error"
				},
				{
					"match": "error LNK[0-9]+: .*$",
					"name": "markup.other.log.error"
				},
				{
					"match": "\\bwarning C[0-9]+(?=:)",
					"name": "markup.other.log.warn"
				}
			]
		},
		"cmake": {
			"patterns": [
				{
					"match": "^\\[[A-Za-z]+\\]",
					"name": "markup.other.log.debug"
				},
				{
					"match": "\\[[0-9]+/[0-9]+\\]",
					"name": "markup.other.log.highlight"
				},
				{
					"match": "Configuring done.*$",
					"name": "markup.other.log.highlight"
				},
				{
					"match": "Generating done.*$",
					"name": "markup.other.log.highlight"
				},
				{
					"match": "FAILED:.*$",
					"name": "markup.other.log.error"
				},
				{
					"match": "CMake Error at.*$",
					"name": "markup.other.log.error"
				},
				{
					"match": "Build files have been.*$",
					"name": "markup.other.log.highlight"
				}
			]
		},
		"tparams": {
			"begin": "<",
			"end": ">",
			"patterns": [
				{
					"begin": "\"",
					"end": "\"",
					"name": "markup.bold.log.error"
				},
				{
					"include": "#tparams"
				},
				{
					"include": "#mstring"
				}
			]
		},
		"mstring": {
			"match": "__mstring<\\d+UL>\\{\\{(.*?)'\\\\000'\\}\\}",
			"captures": {
				"1": {
					"name": "markup.other.log.hidden",
					"patterns": [
						{
							"match": "'\\\\?(.)'",
							"captures": {
								"1": {
									"name": "markup.bold.log.error"
								}
							}
						}
					]
				}
			}
		}
	}
}
